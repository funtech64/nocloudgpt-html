<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Quick Start: Deploy a Private AI in 15 Minutes | NoCloudGPT</title>
<meta name="description" content="Run Llama 3.3 or Mistral Large locally in 15 minutes. No cloud, no data leaks, no API keys. Step-by-step guide for Mac, Linux, and Windows.">
<style>
/* ========== RESET & BASE ========== */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { font-size: 16px; scroll-behavior: smooth; }
body { font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; background: #0a0a0f; color: #e2e8f0; line-height: 1.7; }

/* ========== LAYOUT ========== */
.container { max-width: 860px; margin: 0 auto; padding: 0 24px; }

/* ========== NAV ========== */
nav { background: rgba(10,10,15,0.95); border-bottom: 1px solid #1e293b; padding: 16px 0; position: sticky; top: 0; z-index: 100; backdrop-filter: blur(8px); }
nav .container { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
.nav-brand { font-size: 1.2rem; font-weight: 700; color: #f8fafc; text-decoration: none; letter-spacing: -0.02em; }
.nav-brand span { color: #6366f1; }
.nav-links { display: flex; gap: 24px; list-style: none; flex-wrap: wrap; }
.nav-links a { color: #94a3b8; text-decoration: none; font-size: 0.9rem; transition: color 0.2s; }
.nav-links a:hover, .nav-links a.active { color: #f8fafc; }

/* ========== HERO ========== */
.hero { padding: 64px 0 48px; border-bottom: 1px solid #1e293b; }
.hero-badge { display: inline-block; background: #1e293b; border: 1px solid #334155; color: #6366f1; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; padding: 4px 12px; border-radius: 20px; margin-bottom: 20px; }
.hero h1 { font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 800; line-height: 1.2; letter-spacing: -0.03em; color: #f8fafc; margin-bottom: 16px; }
.hero h1 span { color: #6366f1; }
.hero-sub { font-size: 1.1rem; color: #94a3b8; max-width: 600px; margin-bottom: 32px; }

/* ========== STEP FLOW ========== */
.steps { padding: 48px 0; }
.step { display: flex; gap: 24px; margin-bottom: 40px; }
.step-number { flex-shrink: 0; width: 40px; height: 40px; background: #6366f1; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1rem; color: #fff; margin-top: 4px; }
.step-content h3 { font-size: 1.15rem; font-weight: 700; color: #f8fafc; margin-bottom: 8px; }
.step-content p { color: #94a3b8; margin-bottom: 12px; }

/* ========== CODE BLOCKS ========== */
.code-block { background: #0f172a; border: 1px solid #1e293b; border-radius: 8px; padding: 20px 24px; font-family: 'JetBrains Mono', 'Fira Code', monospace; font-size: 0.88rem; overflow-x: auto; margin: 12px 0; position: relative; }
.code-block .comment { color: #475569; }
.code-block .cmd { color: #a5f3fc; }
.code-block .output { color: #86efac; }
.code-label { font-size: 0.75rem; font-weight: 600; color: #475569; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 6px; }

/* ========== TABS ========== */
.tab-group { margin: 12px 0; }
.tab-buttons { display: flex; gap: 4px; margin-bottom: 0; }
.tab-btn { background: #1e293b; border: 1px solid #334155; border-bottom: none; color: #94a3b8; font-size: 0.8rem; font-weight: 600; padding: 6px 16px; border-radius: 6px 6px 0 0; cursor: pointer; transition: all 0.2s; }
.tab-btn.active { background: #0f172a; color: #f8fafc; border-color: #1e293b; }
.tab-content { display: none; }
.tab-content.active { display: block; }

/* ========== CALLOUTS ========== */
.callout { border-radius: 8px; padding: 16px 20px; margin: 20px 0; border-left: 4px solid; }
.callout-info { background: #0f1f3d; border-color: #3b82f6; }
.callout-info .callout-title { color: #60a5fa; font-weight: 700; margin-bottom: 4px; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; }
.callout-warning { background: #1c1100; border-color: #f59e0b; }
.callout-warning .callout-title { color: #fbbf24; font-weight: 700; margin-bottom: 4px; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; }
.callout-success { background: #0a1f0a; border-color: #22c55e; }
.callout-success .callout-title { color: #4ade80; font-weight: 700; margin-bottom: 4px; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; }

/* ========== MODEL PICKER ========== */
.model-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin: 24px 0; }
.model-card { background: #0f172a; border: 1px solid #1e293b; border-radius: 10px; padding: 20px; transition: border-color 0.2s; }
.model-card:hover { border-color: #6366f1; }
.model-card h4 { color: #f8fafc; font-size: 1rem; font-weight: 700; margin-bottom: 6px; }
.model-card p { color: #64748b; font-size: 0.85rem; margin-bottom: 10px; }
.model-card .pull-cmd { font-family: monospace; font-size: 0.82rem; color: #a5f3fc; background: #0a0a0f; padding: 6px 10px; border-radius: 4px; display: block; }
.badge { display: inline-block; font-size: 0.7rem; font-weight: 700; padding: 2px 8px; border-radius: 10px; margin-bottom: 8px; }
.badge-green { background: #14532d; color: #4ade80; }
.badge-blue { background: #1e3a5f; color: #60a5fa; }
.badge-purple { background: #2e1065; color: #c084fc; }

/* ========== WHAT'S NEXT ========== */
.next-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin: 24px 0; }
.next-card { background: #0f172a; border: 1px solid #1e293b; border-radius: 10px; padding: 20px; text-decoration: none; transition: border-color 0.2s; display: block; }
.next-card:hover { border-color: #6366f1; }
.next-card .next-label { font-size: 0.75rem; color: #475569; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px; }
.next-card h4 { color: #f8fafc; font-size: 0.95rem; font-weight: 700; margin-bottom: 4px; }
.next-card p { color: #64748b; font-size: 0.82rem; }

/* ========== FOOTER ========== */
footer { border-top: 1px solid #1e293b; padding: 40px 0; margin-top: 80px; }
footer .container { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }
.footer-brand { font-size: 1rem; font-weight: 700; color: #f8fafc; }
.footer-brand span { color: #6366f1; }
.footer-links { display: flex; gap: 20px; list-style: none; }
.footer-links a { color: #475569; text-decoration: none; font-size: 0.85rem; transition: color 0.2s; }
.footer-links a:hover { color: #94a3b8; }
.footer-copy { color: #334155; font-size: 0.8rem; }
</style>
